# Plantilla de variables de entorno del proyecto.
#
# El procedimiento consiste en copiar este archivo a .env y ajustar lo que haga falta.
# Cabe señalar que .env está excluido del control de versiones, motivo por el cual las credenciales reales nunca terminan en el repositorio.
#
#   cp .env.ejemplo .env
#
# Todas las variables que aparecen acá tienen un valor por defecto razonable en el código, de manera que el proyecto arranca sin configurar nada.
# En consecuencia, el presente archivo existe para documentar qué se puede cambiar y para el momento en que haga falta hacerlo.

# -----------------------------------------------------------------------------
# Puertos publicados hacia la máquina anfitriona
# -----------------------------------------------------------------------------
#
# Los valores por defecto son los habituales de cada herramienta.
# En caso de que en la máquina ya haya otra cosa escuchando en alguno de ellos, basta con cambiarlo acá sin tocar docker-compose.yml.
# Conviene precisar que este es el conflicto más frecuente al levantar el proyecto en un equipo que ya tiene otros contenedores corriendo.

PUERTO_AIRFLOW=8080
PUERTO_SPARK_MAESTRO=8081
PUERTO_SPARK_TRABAJADOR=8082
PUERTO_SPARK_ENVIO=7077
PUERTO_GRAFANA=3000
PUERTO_PROMETHEUS=9090
PUERTO_PUSHGATEWAY=9091
PUERTO_STATSD=9102
PUERTO_STATSD_UDP=9125
PUERTO_POSTGRES=5432
PUERTO_POSTGRES_EXPORTADOR=9187

# -----------------------------------------------------------------------------
# Límites de recursos
# -----------------------------------------------------------------------------
#
# La variable siguiente fija la memoria máxima de los contenedores de Airflow, que son los que ejecutan el pipeline.
# Al respecto, el valor por defecto alcanza para procesar el histórico completo de más de un millón de filas.
# Declararlo importa porque, sin límite, la presión de memoria la resuelve el sistema operativo matando el proceso más grande, que suele ser justamente la tarea que procesa los datos.
MEMORIA_AIRFLOW=2g

# Cantidad de filas que la ingesta lee y convierte por vez.
# Es decir, bajar este número reduce el pico de memoria a costa de algo de velocidad.
TAMANIO_LOTE_INGESTA=200000

# -----------------------------------------------------------------------------
# Rutas de trabajo
# -----------------------------------------------------------------------------

# Las rutas se admiten tanto relativas a la raíz del proyecto como absolutas.
DIR_DATOS=datos
DIR_CRUDOS=datos/crudos
DIR_EJEMPLOS=datos/ejemplos
DIR_SALIDA=salida

# Nombre del archivo que busca la ingesta dentro del directorio de crudos.
# En caso de que no lo encuentre, la lectura cae automáticamente en la muestra versionada.
ARCHIVO_ENTRADA=ventas_minoristas.csv

# -----------------------------------------------------------------------------
# Reglas de calidad
# -----------------------------------------------------------------------------

# Cantidad mínima aceptada por línea de factura.
# Con el valor en uno se descartan las devoluciones, que en el archivo original figuran en negativo.
CANTIDAD_MINIMA=1

# Las dos variables siguientes acotan el rango de precios considerado válido.
# Conviene precisar que el techo sirve para apartar los cargos administrativos que el comercio registra como si fueran productos.
PRECIO_MINIMO=0.01
PRECIO_MAXIMO=50000.0

# Porcentaje de rechazo a partir del cual el pipeline se detiene en lugar de publicar un resultado poco confiable.
# Cabe señalar que con el archivo completo la corrida normal ronda el 5.5 por ciento.
PORCENTAJE_RECHAZO_MAXIMO=15.0

# -----------------------------------------------------------------------------
# Almacén analítico
# -----------------------------------------------------------------------------

# Dentro de Docker el anfitrión de la base es el nombre del servicio.
# En cambio, para correr el pipeline desde la máquina anfitriona hay que poner localhost.
ALMACEN_HOST=postgres
ALMACEN_PUERTO=5432
ALMACEN_BASE=analitica
ALMACEN_USUARIO=analitica
ALMACEN_CONTRASENA=analitica
ALMACEN_ESQUEMA_CRUDO=crudo

# -----------------------------------------------------------------------------
# Procesamiento distribuido
# -----------------------------------------------------------------------------

# Para usar el clúster de Docker corresponde el valor spark://spark-maestro:7077.
# En cambio, para correr en una sola máquina sin clúster corresponde local[*].
SPARK_MASTER_URL=spark://spark-maestro:7077

# Dirección que los ejecutores usan para devolverle los resultados al controlador.
SPARK_DRIVER_HOST=airflow-programador

# Cantidad de particiones que quedan tras cada barajado.
# El valor por defecto de Spark es doscientos, pensado para clústeres grandes, y con este volumen genera archivos diminutos.
SPARK_PARTICIONES_BARAJADO=8

# -----------------------------------------------------------------------------
# Observabilidad
# -----------------------------------------------------------------------------

PUSHGATEWAY_URL=http://pushgateway:9091
METRICAS_HABILITADAS=true
METRICAS_TRABAJO=pipeline_ventas
METRICAS_TIEMPO_ESPERA=5

# Formato de los registros, donde json corresponde a producción y texto a desarrollo.
FORMATO_LOG=json
NIVEL_LOG=INFO

# -----------------------------------------------------------------------------
# Credenciales de las interfaces web
# -----------------------------------------------------------------------------

# Las credenciales que siguen se deben cambiar antes de exponer los servicios fuera de la máquina local.
AIRFLOW_USUARIO=admin
AIRFLOW_CONTRASENA=admin
GRAFANA_USUARIO=admin
GRAFANA_CONTRASENA=admin
